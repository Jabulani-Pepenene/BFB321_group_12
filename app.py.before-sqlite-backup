                request.form.get("waste_date"),
                "waste date",
                required=True
            )
            quantity = to_decimal(
                request.form.get("quantity"),
                "Quantity wasted",
                Decimal("0.01")
            )

            if not food_name or not unit or not reason:
                raise ValueError(
                    "Food item, unit and reason are required."
                )

            cursor.execute("""
                INSERT INTO food_waste
                    (food_name, quantity, unit, reason, waste_date)
                VALUES (%s, %s, %s, %s, %s)
            """, (food_name, quantity, unit, reason, waste_date))

